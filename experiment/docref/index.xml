&lt;div class="embed-frame"&gt;
&lt;img class="embed-preview" src="https://mixmix.nz/experiment/docref/2026_11_16/loose-ends_hu_dc1604ab5b240a87.webp" srcset="https://mixmix.nz/experiment/docref/2026_11_16/loose-ends_hu_dc1604ab5b240a87.webp 800w, https://mixmix.nz/experiment/docref/2026_11_16/loose-ends_hu_808fadc0acf08ae2.webp 1600w" sizes="(min-width: 1024px) 760px, 100vw" width="800" height="529" alt="Preview of Statute Book Loose Ends" loading="lazy"&gt;
